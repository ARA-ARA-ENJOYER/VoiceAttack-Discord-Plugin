<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VoiceAttack-Discord-Plugin-Setup</AssemblyName>
    <RootNamespace>VoiceAttackDiscordPlugin.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Allows building this Windows-only wizard on non-Windows machines (CI publishes on Windows) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.3.1</Version>
    <!-- Deterministic restores: packages.lock.json is committed, CI restores in locked mode -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Description>Guided installer for the VoiceAttack Discord Plugin</Description>
  </PropertyGroup>

  <!--
    Embed the built plugin payload so the setup is a single file.
    The ProjectReference below guarantees the plugin builds first (same
    configuration), so the globs below always resolve — previously a clean
    `dotnet build` of the solution could evaluate them before the plugin
    output existed and silently ship a payload-less Setup.exe.
  -->
  <ItemGroup>
    <ProjectReference Include="..\VoiceAttackDiscordPlugin\VoiceAttackDiscordPlugin.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PayloadFiles Include="..\VoiceAttackDiscordPlugin\bin\Release\net8.0\*.dll" />
    <PayloadFiles Include="..\VoiceAttackDiscordPlugin\bin\Release\net8.0\*.json" />
    <PayloadFiles Include="..\VoiceAttackDiscordPlugin\config.example.json" />
    <EmbeddedResource Include="@(PayloadFiles)" LogicalName="Payload.%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CheckPayload" BeforeTargets="CoreCompile">
    <Error Condition="'@(PayloadFiles)' == ''"
           Text="Plugin payload is empty: build VoiceAttackDiscordPlugin in Release first (the ProjectReference above should do this automatically)." />
  </Target>

</Project>
