<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>VoiceAttackDiscordPlugin</AssemblyName>
    <RootNamespace>VoiceAttackDiscordPlugin</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>1.4.1</Version>
    <!-- Deterministic restores: packages.lock.json is committed, CI restores in locked mode -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- IL3000 flags Assembly.Location under single-file publish analysis, but
         the plugin is a library VoiceAttack loads from disk — never bundled
         single-file — so Location is correct here. -->
    <NoWarn>$(NoWarn);IL3000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
